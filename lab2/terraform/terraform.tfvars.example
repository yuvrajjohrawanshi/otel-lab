# Copy this file to terraform.tfvars and fill in your values
# cp terraform.tfvars.example terraform.tfvars
#
# NOTE: Terraform will generate an SSH key pair automatically.
#       The private key (.pem) will be saved in this directory after `terraform apply`.
#       The exact path and SSH commands are printed as Terraform outputs.

# ── Required ───────────────────────────────────────────────────────────────────

# Your machine's public IP for SSH access — get it by running: curl ifconfig.me
admin_cidr = "YOUR_PUBLIC_IP/32"

# ── Optional (defaults are fine for the lab) ───────────────────────────────────

# aws_region               = "us-east-1"
# activegate_instance_type = "t3.medium"
# app_instance_type        = "t3.small"
# project_name             = "otel-lab2"
# vpc_cidr                 = "10.10.0.0/16"
# subnet_cidr              = "10.10.1.0/24"
