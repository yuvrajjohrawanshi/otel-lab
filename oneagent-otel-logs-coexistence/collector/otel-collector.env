# /etc/otelcol/collector/otel-collector.env
# Injected into the OTel Collector Gateway systemd service
#
# DT_ACTIVEGATE_ENDPOINT format:
#   https://<ACTIVEGATE_IP_OR_FQDN>:9993/e/<ENVIRONMENT_ID>/api/v2/otlp
#
# DT_API_TOKEN: Create an API token in Dynatrace with these scopes:
#   - openTelemetryTrace.ingest
#   - metrics.ingest
#   - logs.ingest

DT_ACTIVEGATE_ENDPOINT=https://your-activegate.example.com:9993/e/YOUR_ENV_ID/api/v2/otlp
DT_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXX
