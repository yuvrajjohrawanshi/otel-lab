terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      ManagedBy   = "terraform"
      Lab         = "otel-lab2"
    }
  }
}

# ─── SSH Key Pair (generated by Terraform) ───────────────────────────────────

resource "tls_private_key" "lab" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "lab" {
  key_name   = "${var.project_name}-key"
  public_key = tls_private_key.lab.public_key_openssh
  tags       = { Name = "${var.project_name}-key" }
}

# Save the private key locally as a .pem file
resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.lab.private_key_pem
  filename        = "${path.module}/${var.project_name}-key.pem"
  file_permission = "0600"   # owner read-only — required by SSH
}

# ─── Data Sources ─────────────────────────────────────────────────────────────

# Amazon Linux 2023 — RHEL-family (dnf, systemctl, firewall-cmd), always available in all regions
data "aws_ami" "amazon_linux_2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "architecture"
    values = ["x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ─── VPC & Networking ─────────────────────────────────────────────────────────

resource "aws_vpc" "lab" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = { Name = "${var.project_name}-vpc" }
}

resource "aws_internet_gateway" "lab" {
  vpc_id = aws_vpc.lab.id
  tags   = { Name = "${var.project_name}-igw" }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.lab.id
  cidr_block              = var.subnet_cidr
  availability_zone       = "${var.aws_region}a"
  map_public_ip_on_launch = true

  tags = { Name = "${var.project_name}-public-subnet" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.lab.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.lab.id
  }

  tags = { Name = "${var.project_name}-public-rt" }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# ─── Security Groups ──────────────────────────────────────────────────────────

# ActiveGate VM security group
resource "aws_security_group" "activegate" {
  name        = "${var.project_name}-activegate-sg"
  description = "Dynatrace ActiveGate - allow OTLP ingest from App VM and SSH from admin"
  vpc_id      = aws_vpc.lab.id

  # SSH from admin IP only
  ingress {
    description = "SSH from admin"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.admin_cidr]
  }

  # OTLP ingest from the App VM's subnet (OTel Collector → ActiveGate)
  ingress {
    description = "OTLP HTTP ingest from app VM subnet"
    from_port   = 9993
    to_port     = 9993
    protocol    = "tcp"
    cidr_blocks = [var.subnet_cidr]
  }

  # All outbound — needed for ActiveGate → Dynatrace SaaS (443)
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project_name}-activegate-sg" }
}

# App VM security group
resource "aws_security_group" "app_vm" {
  name        = "${var.project_name}-app-sg"
  description = "App VM - SSH and test HTTP access from admin"
  vpc_id      = aws_vpc.lab.id

  # SSH from admin IP only
  ingress {
    description = "SSH from admin"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.admin_cidr]
  }

  # HTTP to Node.js app - publicly accessible for test curls
  ingress {
    description = "Node.js app test port - public"
    from_port   = 3000
    to_port     = 3000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # All outbound — needed for dnf installs, npm, DT ActiveGate
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project_name}-app-sg" }
}

# ─── EC2 Instances ────────────────────────────────────────────────────────────

resource "aws_instance" "activegate" {
  ami                    = data.aws_ami.amazon_linux_2023.id
  instance_type          = var.activegate_instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.activegate.id]
  key_name               = aws_key_pair.lab.key_name

  root_block_device {
    volume_size = 30   # GB — ActiveGate needs ~20GB minimum
    volume_type = "gp3"
    encrypted   = true
  }

  tags = { Name = "${var.project_name}-activegate" }
}

resource "aws_instance" "app_vm" {
  ami                    = data.aws_ami.amazon_linux_2023.id
  instance_type          = var.app_instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.app_vm.id]
  key_name               = aws_key_pair.lab.key_name

  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }

  user_data = file("${path.module}/setup_app.sh")

  tags = { Name = "${var.project_name}-app-vm" }
}
